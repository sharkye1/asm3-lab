%ifndef COLON_INC
%define COLON_INC

; Возвращает имя (адрес) первого узла словаря.
; Оператор %+ склеивает имя словаря с суффиксом _head.
; Форма %define позволяет использовать макрос прямо внутри операнда.
%define dict_head(name) name %+ _head

; Добавляет узел в начало словаря.
; Аргументы: имя словаря, ключ и строка значения.
; Узел имеет формат:
;   +0  указатель на следующий узел
;   +8  указатель на ключ
;   +16 указатель на значение
; После узла макрос размещает строку значения и обновляет голову.
%macro colon 3
%%node:
    dq %{1}_current
    dq %%key
    dq %%value
%%key:
    db %2, 0
%%value:
    db %3, 0
    %xdefine %{1}_current %%node
%endmacro

%endif
