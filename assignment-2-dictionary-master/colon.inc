%ifndef COLON_INC
%define COLON_INC

; возвращает имя (адрес) первого узла словаря.
; оператор %+ склеивает имя словаря с суффиксом _head.
; форма %define позволяет использовать макрос прямо внутри операнда.
%define dict_head(name) name %+ _head

; добавляет узел в начало словаря.
; аргуметны:
;   %1 - имя словаря
;   %2 - строковый ключ
;   %3 - значение: строка в кавычках ЛИБО имя другого словаря

; формат узла:
;   +0  указатель на следующий узел (8 байт)
;   +8  указатель на ключ (8 байт)
;   +16 указатель на значение (8 байт: адрес строки или адрес головы словаря)
%macro colon 3
%ifndef %{1}_current
%xdefine %{1}_current 0
%endif

%%node:
    dq %{1}_current
    dq %%key
%ifstr %3
    dq %%value
%%value:
    db %3, 0
%else
    dq %{3}_head
%endif
%%key:
    db %2, 0
    %xdefine %{1}_current %%node
%endmacro

%endif
